<UserControl x:Class="LearnApp.Win.View.UserGanttAI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LearnApp.Win.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <!-- 顶部标题 -->
            <RowDefinition Height="Auto"/>
            <!-- 顶部按钮栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 无作业滑块 -->
            <RowDefinition Height="Auto"/>
            <!-- 主甘特图区域 -->
            <RowDefinition Height="*"/>
            <!-- 底部时间刻度 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="White" Padding="20,10">
            <DockPanel>
                <TextBlock Text="调度排产结果查看"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#444"
                           DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <TextBlock Text="2025-11-28 -- 2025-12-02"
                               Margin="0,0,20,0"
                               VerticalAlignment="Center"
                               Foreground="#666"/>
                    <Button Content="发布"
                            Width="80" Height="30"
                            Background="#1E88E5" Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- 顶部过滤按钮栏 -->
        <Border Grid.Row="1" Background="White" Padding="10,8">
            <DockPanel>
                <!-- 左侧复选 + 按钮 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- 每个按钮一组：复选框 + 彩色按钮 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox VerticalAlignment="Center" IsChecked="True"/>
                        <Button Content="来油" Margin="4,0,0,0"
                                Padding="10,4"
                                Background="#FFCC66"
                                BorderBrush="#999"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox VerticalAlignment="Center" IsChecked="True"/>
                        <Button Content="加工" Margin="4,0,0,0"
                                Padding="10,4"
                                Background="#00AA66"
                                BorderBrush="#999"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox VerticalAlignment="Center" IsChecked="True"/>
                        <Button Content="倒罐" Margin="4,0,0,0"
                                Padding="10,4"
                                Background="#FF9933"
                                BorderBrush="#999"/>
                    </StackPanel>
                    <!-- 其余按钮同理补齐：1#常减压、2#常减压、停靠、罐区存量、性质查看、来油计划、作业安排、数据统计 ... -->
                </StackPanel>
                <!-- 右侧工具按钮（下载、刷新等图标按钮） -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                            HorizontalAlignment="Right">
                    <Button Width="30" Height="24" Content="⟳"
                            ToolTip="刷新"/>
                    <Button Width="30" Height="24" Content="⬇"
                            ToolTip="导出"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- 无作业滑块 -->
        <Border Grid.Row="2" Background="White" Padding="10,0,10,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="无作业储罐" IsChecked="True"
                          VerticalAlignment="Center"/>
                <Slider Minimum="0" Maximum="100" Value="100"
                        VerticalAlignment="Center"
                        Width="500"/>
            </StackPanel>
        </Border>
        <!-- 主区域：左侧资源行 + 右侧甘特图 -->
        <Grid Grid.Row="3" Background="White">
            <Grid.ColumnDefinitions>
                <!-- 左侧资源名称列 -->
                <ColumnDefinition Width="180"/>
                <!-- 右侧时间轴甘特 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 左侧资源树 / 列表 -->
            <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="0,1,1,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 顶部两级标题：原油码头 / 长输管线等 -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="原油码头(港口)"
                                   Background="#F3F3F3"
                                   Padding="4,2"
                                   FontWeight="Bold"/>
                        <TextBlock Text="长输管线"
                                   Background="#F3F3F3"
                                   Padding="4,2"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                    <!-- 资源行（T-105、T-107 等） -->
                    <ItemsControl Grid.Row="1" Margin="0,4,0,0">
                        <!-- 这里将来绑定你的资源集合 -->
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EEE" BorderThickness="0,0,0,1"
                                        Padding="4,2">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#0066CC"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            <!-- 右侧甘特图区域 -->
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 顶部时间轴一条（灰条） -->
                        <RowDefinition Height="30"/>
                        <!-- 任务条区域 -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- 顶部灰色时间区背景 -->
                    <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,0,1"/>
                    <!-- 任务条容器：每一行对应左侧资源 -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding GanttRows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 单行 -->
                                <Grid Height="26" Margin="0,0,0,1">
                                    <Grid.Background>
                                        <SolidColorBrush Color="#FFFDFDFD"/>
                                    </Grid.Background>
                                    <!-- 背景分隔线 -->
                                    <Border BorderBrush="#EEE" BorderThickness="0,0,0,1"/>
                                    <!-- 该资源上的多个任务块 -->
                                    <ItemsControl ItemsSource="{Binding Tasks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <!-- Left/Width 根据时间换算得到 -->
                                                <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                                                <Setter Property="Width" Value="{Binding Width}"/>
                                                <Setter Property="Height" Value="20"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="2"
                                                        Background="{Binding Fill}"
                                                        BorderBrush="#CCAAAAAA"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding Text}"
                                                               Margin="4,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="Black"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>
        <!-- 底部时间刻度（小时 + 日期） -->
        <Border Grid.Row="4" Background="White" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <Grid>
                <!-- 示例：简单的横向小时刻度 -->
                <ItemsControl ItemsSource="{Binding TimeTicks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EEE" BorderThickness="1,0,0,0" Padding="0,2">
                                <StackPanel>
                                    <TextBlock Text="{Binding Time}" HorizontalAlignment="Center"
                                               FontSize="10" Foreground="#555"/>
                                    <TextBlock Text="{Binding Date}"
                                               HorizontalAlignment="Center"
                                               FontSize="10" Foreground="#0077CC"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
